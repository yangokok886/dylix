 log=[NSString stringWithFormat:@"%@/Tweak.m:12:3: warning: unused variable 'fixture'\n",root];[log writeToFile:[build stringByAppendingPathComponent:@"build.log"] atomically:YES encoding:NSUTF8StringEncoding error:nil];context=[editor aiAttachmentContext:@"diagnostics"];
