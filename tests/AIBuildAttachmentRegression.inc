 availability=[editor aiAttachmentContext:@"availability"];menu=TFAIAttachmentMenu(availability,^(NSString *key){});[menu loadViewIfNeeded];check(TFHasAttachmentSource(menu.view,@"diagnostics")&&TFHasAttachmentSource(menu.view,@"build_log"),@"warning build displays both real context sources");
