 editor.engine.lastBuild=build;NSString *log=@"[11:00:01] clang -cc1 Tweak.m -o Tweak.o\n[11:00:02] ld64.lld -dylib\nBuild succeeded\n";[log writeToFile:[build stringByAppendingPathComponent:@"build.log"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
 JSONWrite(@{@"success":@YES,@"commands":@[@{@"source":@"Tweak.m",@"stage":@"compile",@"exit":@0}],@"artifacts":@[@"Fixture.dylib"]},[build stringByAppendingPathComponent:@"report.json"],nil);
 NSDictionary *context=[editor aiAttachmentContext:@"build_log"];check([context[@"text"] isEqual:log],@"log attachment reads exact saved build.log rather than console summary");check([context[@"available"] boolValue]&&[context[@"title"] isEqual:@"当前构建日志"],@"real log attachment is marked available with descriptive title");
 availability=[editor aiAttachmentContext:@"availability"];check([availability[@"build_log"] boolValue]&&![availability[@"diagnostics"] boolValue],@"successful build without warnings exposes only log");context=[editor aiAttachmentContext:@"diagnostics"];check(![context[@"available"] boolValue]&&![context[@"text"] length]&&[context[@"count"] integerValue]==0,@"empty diagnostics do not serialize build report or artifacts");
