      "validation": {
        "status": "verified",
        "evidence": "evidence/0.5.3-repair-*"
      }
    },
    {
      "id": "TF004",
      "name": "Clang Fix-It 缺失分号",
      "diagnosticConditions": {
        "anyContains": [
          "expected ';'"
        ],
        "caseSensitive": false
      },
      "applicableVersions": {
        "compiler": "LLVM/Clang 14.x",
        "app": "TweakForge >= 0.5.5",
        "platform": "iOS >= 15"
      },
      "explanation": "只接收编译器给出的单个分号插入范围；排除宏、冲突及过期快照。",
      "sources": [
        "https://releases.llvm.org/14.0.0/tools/clang/docs/UsersManual.html#cmdoption-fdiagnostics-parseable-fixits",
        "https://github.com/llvm/llvm-project/blob/llvmorg-14.0.0/clang/test/FixIt/fixit.c"
      ],
      "handling": {
        "category": "repairable",
        "changeKind": "source",
        "handler": "fixit-semicolon",
        "automaticEnabled": true
      },
      "validation": {
        "status": "verified",
        "evidence": "evidence/0.5.5-rules/embedded-fixit; tests/test_rule_library.py"
      }
    },
    {
      "id": "TF005",
