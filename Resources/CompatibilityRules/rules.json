        "caseSensitive": false
      },
      "applicableVersions": {
        "compiler": "LLVM/Clang 14.x",
        "app": "TweakForge >= 0.5.5",
        "platform": "iOS >= 15"
      },
      "explanation": "确认源码实际引用 Mach task 类型，补充 SDK 的 mach/task_info.h。",
      "sources": [
        "https://releases.llvm.org/14.0.0/tools/clang/docs/UsersManual.html",
        "https://github.com/apple-oss-distributions/xnu/blob/main/osfmk/mach/task_info.h"
      ],
      "handling": {
        "category": "repairable",
        "changeKind": "source",
        "handler": "mach",
        "automaticEnabled": true
