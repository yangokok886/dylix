{
  "schemaVersion": 1,
  "compilerMajor": 14,
  "rules": [
    {
      "id": "TF001",
      "name": "weak/strong typeof 的 ObjC++ 拼写",
      "diagnosticConditions": {
        "anyContains": [
          "expected unqualified-id",
          "typeof"
        ],
        "caseSensitive": false
      },
      "applicableVersions": {
        "compiler": "LLVM/Clang 14.x",
        "app": "TweakForge >= 0.5.5",
        "platform": "iOS >= 15"
      },
      "explanation": "在诊断行确认 weak/strong 声明后使用 __typeof__，不做全局替换。",
      "sources": [
        "https://releases.llvm.org/14.0.0/tools/clang/docs/UsersManual.html"
      ],
      "handling": {
        "category": "repairable",
        "changeKind": "source",
        "handler": "typeof",
        "automaticEnabled": true
      },
      "validation": {
        "status": "verified",
        "evidence": "evidence/0.5.3-repair-*"
      }
    },
    {
      "id": "TF002",
      "name": "NSInteger 到枚举的显式转换",
      "diagnosticConditions": {
        "anyContains": [
          "from incompatible type 'NSInteger'"
        ],
        "caseSensitive": false
      },
      "applicableVersions": {
        "compiler": "LLVM/Clang 14.x",
        "app": "TweakForge >= 0.5.5",
        "platform": "iOS >= 15"
      },
      "explanation": "仅适配已诊断的简单 property = [value integerValue]；枚举值合法性由工程负责。",
      "sources": [
        "https://releases.llvm.org/14.0.0/tools/clang/docs/UsersManual.html",
        "https://github.com/llvm/llvm-project/blob/llvmorg-14.0.0/clang/include/clang/Basic/DiagnosticSemaKinds.td"
      ],
      "handling": {
        "category": "repairable",
        "changeKind": "source",
        "handler": "enum",
        "automaticEnabled": true
      },
      "validation": {
        "status": "verified",
        "evidence": "evidence/0.5.3-repair-*"
      }
    },
    {
      "id": "TF003",
      "name": "Mach task 信息声明缺失",
      "diagnosticConditions": {
        "anyContains": [
          "task_basic_info",
          "TASK_BASIC_INFO",
          "task_info_t"
